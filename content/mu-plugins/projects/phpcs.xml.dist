<?xml version="1.0"?>
<ruleset name="Projects Module">
    <description>Human Made coding standards for the projects module.</description>

    <rule ref="coding-standards"/>

    <file>.</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
