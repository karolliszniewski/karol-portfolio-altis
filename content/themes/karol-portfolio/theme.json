{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "960px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{ "slug": "base", "color": "#0f1a3c", "name": "Base" },
				{ "slug": "contrast", "color": "#ffffff", "name": "Contrast" },
				{ "slug": "accent", "color": "#273c83", "name": "Accent" }
			]
		},
		"typography": {
			"fluid": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" }
			}
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Header" },
		{ "area": "footer", "name": "footer", "title": "Footer" }
	]
}
